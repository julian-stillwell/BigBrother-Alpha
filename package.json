    "dockerode": "^4.0.9",
    "envalid": "^8.1.1",
    "fastify": "^5.8.2",
    "pino": "^10.3.1",
    "tar-stream": "^3.1.8"
  },
  "devDependencies": {
    "@sinclair/typebox": "^0.34.48",
    "@types/dockerode": "^4.0.1",
    "@types/node": "^25.5.0",
    "@types/tar-stream": "^3.1.4",
    "nodemon": "^3.1.14",
    "prisma": "^7.5.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
