    "db:generate": "prisma generate",
    "db:deploy": "prisma migrate deploy",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "docker",
    "sandbox",
    "security",
    "testing"
  ],
  "author": "",
