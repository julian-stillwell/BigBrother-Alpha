FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV DISPLAY=:99
ENV WINEARCH=win64
ENV WINEPREFIX=/home/sandboxuser/.wine

# Install Wine and Xvfb
RUN dpkg --add-architecture i386 && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
      wine64 \
      wine32 \
      xvfb \
      xauth \
      ca-certificates \
      coreutils \
    && rm -rf /var/lib/apt/lists/*

# Create non-root sandbox user
RUN useradd -m -s /bin/bash sandboxuser

# Create sandbox working directory
RUN mkdir -p /sandbox && chown sandboxuser:sandboxuser /sandbox

# Pre-initialize Wine prefix (speeds up first run)
USER sandboxuser
RUN wineboot --init 2>/dev/null || true

USER root
COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

USER sandboxuser
WORKDIR /sandbox

ENTRYPOINT ["/entrypoint.sh"]
